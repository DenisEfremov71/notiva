rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each note belongs to the user whose uid is in `user_id`
    // (ownerUserIdFieldName in lib/services/cloud/cloud_storage_constants.dart).
    match /notes/{noteId} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.user_id;
      // The owner can't hand a note over to another user.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.user_id
                    && request.resource.data.user_id == resource.data.user_id;
    }
    // Everything else is denied (no matching rule).
  }
}
