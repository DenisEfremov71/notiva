{
  "[dart]": {
    "editor.formatOnSave": true
  },
  // Flutter's Swift Package Manager integration copies full plugin sources (including their
  // android/ Gradle projects) here. Hide them so Gradle for Java doesn't try to import them.
  "files.exclude": {
    "build/*/SourcePackages": true
  },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.dart$",
        "isAsync": true,
        "cmd": "\"${workspaceFolder}/tool/format_parameters.sh\" \"${file}\""
      }
    ]
  }
}
