<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash for Android 11 and below (Android 12+ uses values-v31/styles.xml) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <!-- Blue gradient circle -->
    <item
        android:width="192dp"
        android:height="192dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/splash_icon_gradient_end"
                android:startColor="@color/splash_icon_gradient_start"
                android:type="linear" />
        </shape>
    </item>

    <!-- Note glyph (240dp bitmap per density) -->
    <item
        android:width="240dp"
        android:height="240dp"
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
</layer-list>
